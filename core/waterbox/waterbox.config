{
  "coreName": "Gens-Rerecording",
  "systemId": "GEN",
  "runsOn": [
    "windows-x86_64"
  ],
  "systemNames": {
    "GEN": "Mega Drive / Genesis"
  },
  "author": "Stephane Dallongeville and the Gens-rr authors; chimera port",
  "url": "https://github.com/TASEmulators/gens-rerecording",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    32,
    4,
    4,
    4,
    64
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. The machine is static data in the ELF (the 6 MiB ROM buffer, its pristine copy for power cycles, RAM, VRAM and the renderer buffers). The mmap arena takes the cartridge while it is read and a movie import.",
  "video": {
    "_comment": "Buffer capacity. The live size comes from GetVideoWidth and GetVideoHeight: 320 or 256 wide, 224 or 240 high.",
    "width": 320,
    "height": 240,
    "virtualWidth": 292,
    "virtualHeight": 224,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 1024,
    "channels": 2,
    "rate": 44100,
    "get": "GetAudio"
  },
  "input": {
    "name": "Genesis Controller",
    "buttons": [
      "Power",
      "Reset",
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 A",
      "P1 B",
      "P1 C",
      "P1 Start",
      "P1 X",
      "P1 Y",
      "P1 Z",
      "P1 Mode",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right",
      "P2 A",
      "P2 B",
      "P2 C",
      "P2 Start",
      "P2 X",
      "P2 Y",
      "P2 Z",
      "P2 Mode",
      "P3 Up",
      "P3 Down",
      "P3 Left",
      "P3 Right",
      "P3 A",
      "P3 B",
      "P3 C",
      "P3 Start",
      "P3 X",
      "P3 Y",
      "P3 Z",
      "P3 Mode"
    ],
    "mnemonics": {
      "Power": "P",
      "Reset": "r",
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "A": "A",
      "B": "B",
      "C": "C",
      "Start": "S",
      "X": "X",
      "Y": "Y",
      "Z": "Z",
      "Mode": "M"
    },
    "players": [
      [
        "P1 Up",
        "P1 Down",
        "P1 Left",
        "P1 Right",
        "P1 A",
        "P1 B",
        "P1 C",
        "P1 Start",
        "P1 X",
        "P1 Y",
        "P1 Z",
        "P1 Mode"
      ],
      [
        "P2 Up",
        "P2 Down",
        "P2 Left",
        "P2 Right",
        "P2 A",
        "P2 B",
        "P2 C",
        "P2 Start",
        "P2 X",
        "P2 Y",
        "P2 Z",
        "P2 Mode"
      ],
      [
        "P3 Up",
        "P3 Down",
        "P3 Left",
        "P3 Right",
        "P3 A",
        "P3 B",
        "P3 C",
        "P3 Start",
        "P3 X",
        "P3 Y",
        "P3 Z",
        "P3 Mode"
      ]
    ]
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".md": "GEN",
    ".gen": "GEN",
    ".bin": "GEN",
    ".smd": "GEN"
  },
  "tools": [
    {
      "id": "import_gmv",
      "menu": "import.menu",
      "description": "import.about",
      "inputs": [
        {
          "name": "movie",
          "label": "import.movie",
          "required": true,
          "extensions": [
            "gmv"
          ]
        },
        {
          "name": "cartridge",
          "label": "import.rom",
          "required": true,
          "extensions": [
            "md",
            "gen",
            "bin",
            "smd"
          ]
        }
      ],
      "outputs": [
        {
          "name": "project",
          "label": "import.project",
          "extension": "chimeraProject",
          "nameFrom": "movie",
          "project": true
        }
      ]
    }
  ],
  "settings": [
    {
      "name": "region",
      "display": "setting.region",
      "description": "setting.region.about",
      "type": "enum",
      "default": "auto",
      "sync": true,
      "options": [
        "auto",
        "japan_ntsc",
        "usa",
        "europe",
        "japan_pal"
      ]
    },
    {
      "name": "p1Pad",
      "display": "setting.p1pad",
      "description": "setting.p1pad.about",
      "type": "enum",
      "default": "six",
      "sync": true,
      "options": [
        "six",
        "three"
      ]
    },
    {
      "name": "p2Pad",
      "display": "setting.p2pad",
      "description": "setting.p2pad.about",
      "type": "enum",
      "default": "six",
      "sync": true,
      "options": [
        "six",
        "three"
      ]
    },
    {
      "name": "teamPlayer",
      "display": "setting.teamplayer",
      "description": "setting.teamplayer.about",
      "type": "bool",
      "default": false,
      "sync": true
    },
    {
      "name": "p1bPad",
      "display": "setting.p1bpad",
      "description": "setting.p1bpad.about",
      "type": "enum",
      "default": "three",
      "sync": true,
      "options": [
        "three",
        "six"
      ]
    },
    {
      "name": "p1cPad",
      "display": "setting.p1cpad",
      "description": "setting.p1cpad.about",
      "type": "enum",
      "default": "three",
      "sync": true,
      "options": [
        "three",
        "six"
      ]
    },
    {
      "name": "ym2612Improvement",
      "display": "setting.ym2612improvement",
      "description": "setting.ym2612improvement.about",
      "type": "bool",
      "default": false,
      "sync": true
    },
    {
      "name": "spriteLimit",
      "display": "setting.spritelimit",
      "description": "setting.spritelimit.about",
      "type": "bool",
      "default": true,
      "sync": true
    }
  ]
}
